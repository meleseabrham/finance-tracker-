PORT=5000
NODE_ENV=development

# PostgreSQL — matches docker-compose defaults
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finance_tracker
DB_USER=postgres
DB_PASSWORD=postgres

# JWT — change this before deploying to production
JWT_SECRET=fintrack_dev_secret_change_me
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Seeded admin user — change before deploying to production
ADMIN_EMAIL=admin@fintrack.com
ADMIN_PASSWORD=change_me_admin_password
